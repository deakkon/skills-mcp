APP_ENV=local
LOG_LEVEL=INFO

# Skill source of truth, mounted into Docker as /skills
SKILLS_ROOT=/skills
HOST_SKILLS_ROOT=/Users/jurica/agent-skill-library/skills

# Native folders, guardrails only
CODEX_NATIVE_SKILLS_DIR=/Users/jurica/.agents/skills
ANTIGRAVITY_NATIVE_SKILLS_DIR=/Users/jurica/.gemini/antigravity/skills
MAX_NATIVE_SKILLS_ALLOWED=20

# Qdrant, inside Docker network
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_SKILLS=skills_mcp_skills_v1
QDRANT_RECREATE_COLLECTION=false

# Qdrant, host access for debugging
QDRANT_HOST_URL=http://localhost:6335

# Embeddings, Ollama runs locally on host
EMBEDDINGS_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_HOST_URL=http://localhost:11434
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_DIMENSIONS=768
EMBEDDINGS_KEEP_ALIVE=10m
EMBEDDINGS_BATCH_SIZE=32

# Planner
PLANNER_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PLANNER_MODEL=anthropic/claude-3.5-haiku
PLANNER_FALLBACK_MODEL=openai/gpt-4o-mini
PLANNER_TEMPERATURE=0
PLANNER_MAX_LANES=6
PLANNER_MAX_TOTAL_SKILLS=12

# Skill-aware planning
SKILL_PLANNING_ENABLED=true
SKILL_PLANNING_MAX_TASKS=20
SKILL_PLANNING_MAX_SKILLS_PER_TASK=5
SKILL_PLANNING_LOAD_POLICY=defer_bodies

# Observability, mounted into Docker as /app/data
OBSERVABILITY_ENABLED=true
OBSERVABILITY_JSONL_PATH=/app/data/events.jsonl
OBSERVABILITY_SQLITE_PATH=/app/data/skills_mcp.sqlite
OBSERVABILITY_CAPTURE_CANDIDATES=true
OBSERVABILITY_REDACT_SECRETS=true

# Docker
COMPOSE_PROJECT_NAME=skills-mcp
DOCKER_QDRANT_VOLUME=skills_mcp_qdrant_storage

# MCP runtime metadata
MCP_TRANSPORT=stdio
MCP_SERVER_NAME=skills-mcp
MCP_CANONICAL_CONFIG=/Users/jurica/.mcp/canonical.json
MCP_RUN_SCRIPT=/Users/jurica/Code/skills-mcp/scripts/run-mcp-local.sh
